<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-create-checkin-events-table" author="system">
        <comment>Create checkin_events table for Flink consumer event deduplication</comment>

        <createTable tableName="checkin_events">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="event_id" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="checkin_date" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="event_timestamp" type="DATETIME">
                <constraints nullable="false"/>
            </column>

            <column name="year_month" type="VARCHAR(6)">
                <constraints nullable="false"/>
            </column>

            <column name="points_earned" type="INT">
                <constraints nullable="true"/>
            </column>

            <column name="processed" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="processed_at" type="DATETIME">
                <constraints nullable="true"/>
            </column>

            <column name="error_message" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>

            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_event_id" tableName="checkin_events">
            <column name="event_id"/>
        </createIndex>

        <createIndex indexName="idx_user_checkin_date" tableName="checkin_events">
            <column name="user_id"/>
            <column name="checkin_date"/>
        </createIndex>

        <createIndex indexName="idx_year_month" tableName="checkin_events">
            <column name="year_month"/>
        </createIndex>

        <createIndex indexName="idx_processed" tableName="checkin_events">
            <column name="processed"/>
        </createIndex>

        <createIndex indexName="idx_created_at" tableName="checkin_events">
            <column name="created_at"/>
        </createIndex>

        <rollback>
            <dropTable tableName="checkin_events"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
